config_version=5

[application]
config/name="Caseboard Starter Kit"
run/main_scene="res://demo/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://art/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=820
window/size/window_width_override=1280
window/size/window_height_override=820
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.06, 0.1, 0.12, 1)
